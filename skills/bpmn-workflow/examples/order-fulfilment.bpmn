<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="sys_definitions" targetNamespace="urn:bpmn-workflow" exporter="bpmn-workflow" exporterVersion="0.1.0">
  <bpmn:collaboration id="sys_collaboration">
    <bpmn:participant id="sys_participant" name="Order fulfilment: validate, replenish, prepare and dispatch" processRef="sys_process" />
    <bpmn:participant id="user_customer" name="Customer" />
    <bpmn:messageFlow id="user_order_request" name="Order request" sourceRef="user_customer" targetRef="user_received" />
    <bpmn:messageFlow id="user_dispatch_message" name="Dispatch confirmation" sourceRef="user_dispatch_order" targetRef="user_customer" />
  </bpmn:collaboration>
  <bpmn:process id="sys_process" name="Order fulfilment: validate, replenish, prepare and dispatch" isExecutable="false">
    <bpmn:documentation>Descriptive BPMN interchange model; no execution engine is included.</bpmn:documentation>
    <bpmn:laneSet id="sys_lanes">
      <bpmn:lane id="user_operations" name="Order operations">
        <bpmn:flowNodeRef>user_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_record_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_validate_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_valid_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_reject_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="user_warehouse" name="Warehouse team">
        <bpmn:flowNodeRef>user_stock_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_await_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_prepare_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_pack_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_prepared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_dispatch_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="user_finance" name="Finance team" />
      <bpmn:lane id="user_systems" name="Order, inventory and billing systems">
        <bpmn:flowNodeRef>user_check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>user_create_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="user_received" name="Customer order received">
      <bpmn:documentation>Performer: operations</bpmn:documentation>
    </bpmn:startEvent>
    <bpmn:userTask id="user_record_order" name="Record the requested items and delivery address">
      <bpmn:documentation>Record the supplied order details and preserve unresolved fields.
Performer: operations</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="user_validate_order" name="Validate the order details and delivery requirements">
      <bpmn:documentation>Check the agreed acceptance criteria; do not infer missing order details.
Performer: operations</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="user_valid_order" name="Are the order details valid?" default="user_f_invalid">
      <bpmn:documentation>Performer: operations</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="user_reject_order" name="Explain the invalid order and request corrections">
      <bpmn:documentation>Performer: operations</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="user_rejected" name="Order rejected with reasons">
      <bpmn:documentation>Performer: operations</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:serviceTask id="user_check_stock" name="Check item availability against inventory">
      <bpmn:documentation>Performer: systems
Accountable role: warehouse</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="user_stock_available" name="Are all ordered items available?" default="user_f_stock_pending">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="user_await_stock" name="Request replenishment and await stock confirmation">
      <bpmn:documentation>Keep the order pending until the stock confirmation is received, then recheck inventory. No timer or ordering integration is executed by this tool.
Performer: warehouse</bpmn:documentation>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="user_prepare_order" name="Prepare packing and invoicing in parallel" gatewayDirection="Diverging">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="user_pack_order" name="Pick and pack the ordered items">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:serviceTask id="user_create_invoice" name="Create the customer invoice in the billing system">
      <bpmn:documentation>Performer: systems
Accountable role: finance</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="user_prepared" name="Packing and invoicing both complete" gatewayDirection="Converging">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:userTask id="user_dispatch_order" name="Dispatch the package and record shipment details">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:endEvent id="user_complete" name="Order dispatched with confirmation">
      <bpmn:documentation>Performer: warehouse</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:dataObject id="sys_product_record_order_output_0_object" />
    <bpmn:dataObjectReference id="sys_product_record_order_output_0" name="Sales order" dataObjectRef="sys_product_record_order_output_0_object">
      <bpmn:documentation>Work product: Sales order
Direction: Output</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_validate_order_input_0_object" />
    <bpmn:dataObjectReference id="sys_product_validate_order_input_0" name="Sales order" dataObjectRef="sys_product_validate_order_input_0_object">
      <bpmn:documentation>Work product: Sales order
Direction: Input</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_check_stock_input_0_object" />
    <bpmn:dataObjectReference id="sys_product_check_stock_input_0" name="Sales order" dataObjectRef="sys_product_check_stock_input_0_object">
      <bpmn:documentation>Work product: Sales order
Direction: Input</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_pack_order_input_0_object" />
    <bpmn:dataObjectReference id="sys_product_pack_order_input_0" name="Sales order" dataObjectRef="sys_product_pack_order_input_0_object">
      <bpmn:documentation>Work product: Sales order
Direction: Input</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_create_invoice_input_0_object" />
    <bpmn:dataObjectReference id="sys_product_create_invoice_input_0" name="Sales order" dataObjectRef="sys_product_create_invoice_input_0_object">
      <bpmn:documentation>Work product: Sales order
Direction: Input</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_create_invoice_output_1_object" />
    <bpmn:dataObjectReference id="sys_product_create_invoice_output_1" name="Customer invoice" dataObjectRef="sys_product_create_invoice_output_1_object">
      <bpmn:documentation>Work product: Customer invoice
Direction: Output</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="sys_product_dispatch_order_input_0_object" />
    <bpmn:dataObjectReference id="sys_product_dispatch_order_input_0" name="Customer invoice" dataObjectRef="sys_product_dispatch_order_input_0_object">
      <bpmn:documentation>Work product: Customer invoice
Direction: Input</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="sys_product_dispatch_order_output_1" name="Dispatch confirmation">
      <bpmn:documentation>Work product: Dispatch confirmation
Direction: Output</bpmn:documentation>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="user_f_received_record" sourceRef="user_received" targetRef="user_record_order" />
    <bpmn:sequenceFlow id="user_f_record_validate" sourceRef="user_record_order" targetRef="user_validate_order" />
    <bpmn:sequenceFlow id="user_f_validate_decision" sourceRef="user_validate_order" targetRef="user_valid_order" />
    <bpmn:sequenceFlow id="user_f_rejected" sourceRef="user_reject_order" targetRef="user_rejected" />
    <bpmn:sequenceFlow id="user_f_stock_decision" sourceRef="user_check_stock" targetRef="user_stock_available" />
    <bpmn:sequenceFlow id="user_f_recheck" sourceRef="user_await_stock" targetRef="user_check_stock" name="Stock confirmation received: recheck" />
    <bpmn:sequenceFlow id="user_f_pack" sourceRef="user_prepare_order" targetRef="user_pack_order" />
    <bpmn:sequenceFlow id="user_f_invoice" sourceRef="user_prepare_order" targetRef="user_create_invoice" />
    <bpmn:sequenceFlow id="user_f_pack_join" sourceRef="user_pack_order" targetRef="user_prepared" />
    <bpmn:sequenceFlow id="user_f_invoice_join" sourceRef="user_create_invoice" targetRef="user_prepared" />
    <bpmn:sequenceFlow id="user_f_dispatch" sourceRef="user_prepared" targetRef="user_dispatch_order" />
    <bpmn:sequenceFlow id="user_f_complete" sourceRef="user_dispatch_order" targetRef="user_complete" />
    <bpmn:sequenceFlow id="user_f_invalid" sourceRef="user_valid_order" targetRef="user_reject_order" name="No: explain the corrections needed" />
    <bpmn:sequenceFlow id="user_f_valid" sourceRef="user_valid_order" targetRef="user_check_stock" name="Yes: check inventory">
      <bpmn:conditionExpression language="urn:bpmn-workflow:condition:v1" xsi:type="bpmn:tFormalExpression">Order details meet the supplied acceptance criteria</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="user_f_stock_pending" sourceRef="user_stock_available" targetRef="user_await_stock" name="No: await replenishment" />
    <bpmn:sequenceFlow id="user_f_stock_ready" sourceRef="user_stock_available" targetRef="user_prepare_order" name="Yes: prepare the order">
      <bpmn:conditionExpression language="urn:bpmn-workflow:condition:v1" xsi:type="bpmn:tFormalExpression">All ordered items are available</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="sys_info_record_order">
      <bpmn:text>Uses: Order management system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_record_order_link" sourceRef="user_record_order" targetRef="sys_info_record_order" />
    <bpmn:association id="sys_product_record_order_output_0_link" sourceRef="user_record_order" targetRef="sys_product_record_order_output_0" associationDirection="One" />
    <bpmn:textAnnotation id="sys_info_validate_order">
      <bpmn:text>Uses: Order management system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_validate_order_link" sourceRef="user_validate_order" targetRef="sys_info_validate_order" />
    <bpmn:association id="sys_product_validate_order_input_0_link" sourceRef="sys_product_validate_order_input_0" targetRef="user_validate_order" associationDirection="One" />
    <bpmn:textAnnotation id="sys_info_reject_order">
      <bpmn:text>Uses: Order management system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_reject_order_link" sourceRef="user_reject_order" targetRef="sys_info_reject_order" />
    <bpmn:textAnnotation id="sys_info_check_stock">
      <bpmn:text>Uses: Inventory system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_check_stock_link" sourceRef="user_check_stock" targetRef="sys_info_check_stock" />
    <bpmn:association id="sys_product_check_stock_input_0_link" sourceRef="sys_product_check_stock_input_0" targetRef="user_check_stock" associationDirection="One" />
    <bpmn:textAnnotation id="sys_info_await_stock">
      <bpmn:text>Uses: Inventory system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_await_stock_link" sourceRef="user_await_stock" targetRef="sys_info_await_stock" />
    <bpmn:association id="sys_product_pack_order_input_0_link" sourceRef="sys_product_pack_order_input_0" targetRef="user_pack_order" associationDirection="One" />
    <bpmn:textAnnotation id="sys_info_create_invoice">
      <bpmn:text>Uses: Billing system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_create_invoice_link" sourceRef="user_create_invoice" targetRef="sys_info_create_invoice" />
    <bpmn:association id="sys_product_create_invoice_input_0_link" sourceRef="sys_product_create_invoice_input_0" targetRef="user_create_invoice" associationDirection="One" />
    <bpmn:association id="sys_product_create_invoice_output_1_link" sourceRef="user_create_invoice" targetRef="sys_product_create_invoice_output_1" associationDirection="One" />
    <bpmn:textAnnotation id="sys_info_dispatch_order">
      <bpmn:text>Uses: Order management system</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="sys_info_dispatch_order_link" sourceRef="user_dispatch_order" targetRef="sys_info_dispatch_order" />
    <bpmn:association id="sys_product_dispatch_order_input_0_link" sourceRef="sys_product_dispatch_order_input_0" targetRef="user_dispatch_order" associationDirection="One" />
    <bpmn:association id="sys_product_dispatch_order_output_1_link" sourceRef="user_dispatch_order" targetRef="sys_product_dispatch_order_output_1" associationDirection="One" />
  </bpmn:process>
