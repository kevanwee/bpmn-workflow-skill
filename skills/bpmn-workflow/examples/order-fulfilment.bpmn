    <bpmndi:BPMNPlane id="sys_plane" bpmnElement="sys_collaboration">
      <bpmndi:BPMNShape id="shape_sys_participant" bpmnElement="sys_participant" isHorizontal="true">
        <dc:Bounds x="30" y="60" width="4320" height="1755" />
