        <dc:Bounds x="2350" y="450" width="240" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="di_sys_info_await_stock_link" bpmnElement="sys_info_await_stock_link">
        <di:waypoint x="2470.0" y="525" />
        <di:waypoint x="2470.0" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="shape_sys_product_pack_order_input_0" bpmnElement="sys_product_pack_order_input_0">
        <dc:Bounds x="2700" y="660" width="125" height="70" />
