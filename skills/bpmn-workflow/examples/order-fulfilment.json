{
 "name":"Order fulfilment: validate, replenish, prepare and dispatch",
 "purpose":"Fulfil an accepted order, or return a clear rejection. Keep replenishment and parallel packing/invoicing visible. Illustrative process only.",
 "trigger":"A customer submits an order request.",
 "lanes":[{"id":"operations","name":"Order operations"},{"id":"warehouse","name":"Warehouse team"},{"id":"finance","name":"Finance team"},{"id":"systems","name":"Order, inventory and billing systems","participant":"system"},{"id":"customer","name":"Customer","scope":"external"}],
 "systems":[{"id":"order-system","name":"Order management system"},{"id":"inventory-system","name":"Inventory system"},{"id":"billing-system","name":"Billing system"}],
 "work_products":[{"id":"order-record","name":"Sales order","kind":"document"},{"id":"invoice-record","name":"Customer invoice","kind":"document"},{"id":"dispatch-record","name":"Dispatch confirmation","kind":"data_store"}],
 "nodes":[
  {"id":"received","name":"Customer order received","type":"start","lane":"operations"},
  {"id":"record-order","name":"Record the requested items and delivery address","type":"user","lane":"operations","system_refs":["order-system"],"work_products_out":["order-record"],"instructions":"Record the supplied order details and preserve unresolved fields."},
  {"id":"validate-order","name":"Validate the order details and delivery requirements","type":"user","lane":"operations","system_refs":["order-system"],"work_products_in":["order-record"],"instructions":"Check the agreed acceptance criteria; do not infer missing order details."},
  {"id":"valid-order","name":"Are the order details valid?","type":"exclusive","lane":"operations"},
  {"id":"reject-order","name":"Explain the invalid order and request corrections","type":"user","lane":"operations","system_refs":["order-system"]},
  {"id":"rejected","name":"Order rejected with reasons","type":"end","lane":"operations"},
  {"id":"check-stock","name":"Check item availability against inventory","type":"service","lane":"systems","responsible_role":"warehouse","system_refs":["inventory-system"],"work_products_in":["order-record"]},
  {"id":"stock-available","name":"Are all ordered items available?","type":"exclusive","lane":"warehouse"},
  {"id":"await-stock","name":"Request replenishment and await stock confirmation","type":"receive","lane":"warehouse","system_refs":["inventory-system"],"instructions":"Keep the order pending until the stock confirmation is received, then recheck inventory. No timer or ordering integration is executed by this tool."},
  {"id":"prepare-order","name":"Prepare packing and invoicing in parallel","type":"parallel-split","lane":"warehouse"},
  {"id":"pack-order","name":"Pick and pack the ordered items","type":"manual","lane":"warehouse","work_products_in":["order-record"]},
  {"id":"create-invoice","name":"Create the customer invoice in the billing system","type":"service","lane":"systems","responsible_role":"finance","system_refs":["billing-system"],"work_products_in":["order-record"],"work_products_out":["invoice-record"]},
  {"id":"prepared","name":"Packing and invoicing both complete","type":"parallel-join","lane":"warehouse"},
  {"id":"dispatch-order","name":"Dispatch the package and record shipment details","type":"user","lane":"warehouse","system_refs":["order-system"],"work_products_in":["invoice-record"],"work_products_out":["dispatch-record"]},
  {"id":"complete","name":"Order dispatched with confirmation","type":"end","lane":"warehouse"}
 ],
 "flows":[
  {"id":"f-received-record","source":"received","target":"record-order"},
  {"id":"f-record-validate","source":"record-order","target":"validate-order"},
  {"id":"f-validate-decision","source":"validate-order","target":"valid-order"},
  {"id":"f-invalid","source":"valid-order","target":"reject-order","label":"No: explain the corrections needed","default":true},
  {"id":"f-rejected","source":"reject-order","target":"rejected"},
  {"id":"f-valid","source":"valid-order","target":"check-stock","label":"Yes: check inventory","condition":"Order details meet the supplied acceptance criteria"},
  {"id":"f-stock-decision","source":"check-stock","target":"stock-available"},
  {"id":"f-stock-pending","source":"stock-available","target":"await-stock","label":"No: await replenishment","default":true},
  {"id":"f-recheck","source":"await-stock","target":"check-stock","label":"Stock confirmation received: recheck"},
  {"id":"f-stock-ready","source":"stock-available","target":"prepare-order","label":"Yes: prepare the order","condition":"All ordered items are available"},
  {"id":"f-pack","source":"prepare-order","target":"pack-order"},
  {"id":"f-invoice","source":"prepare-order","target":"create-invoice"},
  {"id":"f-pack-join","source":"pack-order","target":"prepared"},
  {"id":"f-invoice-join","source":"create-invoice","target":"prepared"},
  {"id":"f-dispatch","source":"prepared","target":"dispatch-order"},
  {"id":"f-complete","source":"dispatch-order","target":"complete"}
 ],
 "messages":[{"id":"order-request","name":"Order request","source":"customer","target":"received"},{"id":"dispatch-message","name":"Dispatch confirmation","source":"dispatch-order","target":"customer"}]
}
