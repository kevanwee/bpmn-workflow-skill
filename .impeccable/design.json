  "narrative": {
    "northStar": "The quiet working surface",
    "overview": "This phrase describes the inherited direction recorded in PRODUCT.md, rather than a new identity. Near-white surfaces, dark green ink and restrained green actions frame an immediately available diagram. The canvas is the main working area; the shell supplies compact controls and readable context.\n\nThis document records the shipped editor in `skills/bpmn-workflow/editor`, checked against the desktop and mobile review captures listed in `docs/screenshots.json`. The bpmn.io canvas, palette, symbols and attribution remain the upstream visual system; the shell does not redefine BPMN notation.",
    "keyCharacteristics": [
      "A large white diagram canvas with a narrow contextual inspector.",
      "A compact, wrapping toolbar with restrained green primary actions.",
      "System typography, thin borders and flat surfaces.",
      "A visible editing boundary and persistent status feedback."
    ],
    "rules": [
      {
        "name": "The Canvas Rule",
        "body": "Keep shell colors separate from the upstream diagram notation; preserve bpmn.io's familiar symbols and attribution.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the inherited white/green shell and original bpmn.io notation.",
      "Do keep the canvas dominant and allow toolbar controls to wrap on narrow screens.",
      "Do preserve visible keyboard focus, reduced-motion handling and persistent status feedback.",
      "Do keep editing limits and the illustrative nature of the example visible."
    ],
    "donts": [
      "Don't add decorative shadows, cards or display fonts to this scoped extraction.",
      "Don't recolor BPMN notation to match the shell accent or remove upstream attribution.",
      "Don't present diagram validation or editing as task execution or proof of business outcomes.",
